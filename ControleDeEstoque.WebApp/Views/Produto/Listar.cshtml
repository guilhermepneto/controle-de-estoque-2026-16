@model List<ListarProdutoViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Produtos";
}

<p>
    <a class="btn btn-primary" asp-action="Cadastrar">
        <i class="bi bi-patch-plus"></i>
        Cadastrar produto
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-4" role="alert">
        Não há nenhum produto registrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-4">
        @foreach (ListarProdutoViewModel m in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5>@m.Nome</h5>
                            <span class="badge text-bg-secondary">@m.Id</span>
                        </div>

                        <p class="card-text">@m.Descricao</p>

                        <dl class="row mb-2">
                            <dt class="col-sm-8">Fornecedor</dt>
                            <dd class="col-sm-4">@m.NomeFornecedor</dd>

                            <dt class="col-sm-10">Em Estoque</dt>
                            <dd class="col-sm-2">@m.QuantidadeEmEstoque</dd>
                        </dl>

                        <div class="d-flex gap-2 justify-content-end mt-auto">
                            <a class="btn btn-sm btn-outline-primary" title="Editar" asp-action="Editar" asp-route-id="@m.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" title="Excluir" asp-action="Excluir" asp-route-id="@m.Id">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
