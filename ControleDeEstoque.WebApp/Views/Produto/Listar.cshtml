@model List<ListarProdutoViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = ViewBag.Titulo ?? "Listagem de Produtos";
    CategoriaProduto? categoria = ViewBag.Categoria as CategoriaProduto?;
}

<p class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" asp-action="Cadastrar" asp-route-categoria="@(categoria ?? CategoriaProduto.Geral)">
        <i class="bi bi-patch-plus"></i>
        Cadastrar @(categoria == CategoriaProduto.Tinta ? "tinta" : categoria == CategoriaProduto.Toner ? "toner" :
            "produto")
    </a>
    <a class="btn btn-outline-secondary" asp-action="Listar">Todos</a>
    <a class="btn btn-outline-secondary" asp-action="Listar" asp-route-categoria="@CategoriaProduto.Tinta">Tintas</a>
    <a class="btn btn-outline-secondary" asp-action="Listar" asp-route-categoria="@CategoriaProduto.Toner">Toners</a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-4">Não há nenhum item registrado nesta categoria.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-4">
        @foreach (ListarProdutoViewModel m in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5>@m.Nome</h5>
                            <span class="badge text-bg-secondary">@m.Id</span>
                        </div>

                        <p class="card-text">@m.Descricao</p>

                        <dl class="row mb-2">
                            <dt class="col-sm-5">Categoria</dt>
                            <dd class="col-sm-7">@m.Categoria</dd>
                            <dt class="col-sm-5">Fornecedor</dt>
                            <dd class="col-sm-7">@m.NomeFornecedor</dd>
                            <dt class="col-sm-8">Em Estoque</dt>
                            <dd class="col-sm-4">@m.QuantidadeEmEstoque</dd>
                        </dl>

                        <div class="d-flex gap-2 justify-content-end mt-auto">
                            <a class="btn btn-sm btn-outline-primary" title="Editar" asp-action="Editar" asp-route-id="@m.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" title="Excluir" asp-action="Excluir" asp-route-id="@m.Id">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
