@model EditarProdutoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Produto";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Editar" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div>
            <label class="form-label" asp-for="Nome">Nome</label>
            <input class="form-control" asp-for="Nome" type="text">
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Descricao">Descrição</label>
            <textarea class="form-control" asp-for="Descricao"></textarea>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Categoria">Categoria</label>
            <select class="form-select" asp-for="Categoria">
                <option value="@CategoriaProduto.Geral">Produto geral</option>
                <option value="@CategoriaProduto.Tinta">Tinta</option>
                <option value="@CategoriaProduto.Toner">Toner</option>
            </select>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="FornecedorId">Fornecedor</label>
            <select class="form-select" asp-for="FornecedorId">
                @foreach (FornecedorProdutoViewModel f in Model.Fornecedores)
                {
                    <option value="@f.Id">@f.Nome</option>
                }
            </select>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check"></i>
                Confirmar edição
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i>
                Voltar para a lista
            </a>
        </div>
    </form>
</div>
