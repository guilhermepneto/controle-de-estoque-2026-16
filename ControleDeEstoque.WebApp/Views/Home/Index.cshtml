@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}

<div style="
    min-height: calc(100vh - 56px);
    background-color: #cdd0d4;
    margin-top: -1.5rem;
    margin-bottom: -1.5rem;
    margin-left: calc((100% - 100vw) / 2);
    margin-right: calc((100% - 100vw) / 2);
    display: flex;
    align-items: center;
    ">

    <div class="container">
        <div class="row align-items-center justify-content-center w-100">

            <div class="col-12 col-lg-6 text-center mb-5 mb-lg-0">
                <img src="~/img/logo-ssa-vetor.svg" class="img-fluid" style="max-width: 420px; opacity: 0.85;">
            </div>

            <div class="col-12 col-lg-5">

                <a asp-controller="Produto" asp-action="Listar" class="text-decoration-none">

                    <div class="p-4 mb-4 rounded-3 shadow" style="
                        background: linear-gradient(135deg, #0d6efd, #084298);
                        color: white;
                        border-left: 6px solid yellow;
                        ">

                        <div class="d-flex align-items-center">
                            <i class="bi bi-box-seam fs-1 me-3"></i>

                            <div>
                                <h3 class="mb-1">PRODUTOS</h3>
                                <span>@ViewBag.TotalProdutos cadastrados</span>
                            </div>
                        </div>

                    </div>
                </a>

                <a asp-controller="Estoque" asp-action="Listar" class="text-decoration-none">

                    <div class="p-4 rounded-3 shadow" style="
                        background: linear-gradient(135deg, #0d6efd, #084298);
                        color: white;
                        border-left: 6px solid #dc3545;
                        ">

                        <div class="d-flex align-items-center">
                            <i class="bi bi-clipboard-data fs-1 me-3"></i>

                            <div>
                                <h3 class="mb-1">ESTOQUE</h3>
                                <span>@ViewBag.TotalEstoque itens</span>
                            </div>
                        </div>

                    </div>
                </a>

            </div>

        </div>
    </div>

</div>