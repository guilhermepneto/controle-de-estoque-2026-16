@model EditarClienteViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Cliente";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Editar" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div>
            <label class="form-label" asp-for="Nome">Nome</label>
            <input class="form-control" asp-for="Nome" type="text">
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Telefone">Telefone</label>
            <input class="form-control" asp-for="Telefone" type="text">
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Email">E-mail</label>
            <input class="form-control" asp-for="Email" type="email" placeholder="Opcional">
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="TipoDocumento">Documento</label>
            <select class="form-select" asp-for="TipoDocumento" id="tipoDocumento">
                <option value="@TipoDocumentoCliente.CPF">CPF</option>
                <option value="@TipoDocumentoCliente.CNPJ">CNPJ</option>
            </select>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Cpf" id="labelDocumento">@(Model.TipoDocumento ==
                                TipoDocumentoCliente.CNPJ ? "CNPJ" : "CPF")</label>
                <input class="form-control" asp-for="Cpf" type="text" id="documento">
            </div>

            <div class="d-flex gap-3 mt-4">
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-check"></i>
                    Confirmar edição
                </button>
                <a class="btn btn-outline-secondary" asp-action="Listar">
                    <i class="bi bi-arrow-return-left"></i>
                    Voltar para a lista
                </a>
            </div>
        </form>
    </div>

    <script>
        document.getElementById("tipoDocumento").addEventListener("change", function () {
            document.getElementById("labelDocumento").textContent = this.value === "CNPJ" ? "CNPJ" : "CPF";
            document.getElementById("documento").placeholder = this.value === "CNPJ" ? "14 dígitos" : "11 dígitos";
        });
    </script>
