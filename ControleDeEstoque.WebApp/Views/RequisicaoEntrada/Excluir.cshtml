@model RequisicaoEntrada

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Requisição de Entrada";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Excluir" asp-route-id="@Model.Id" method="post">
        <div class="alert alert-danger mt-4" role="alert">
            Você deseja realmente excluir a entrada do produto "@Model.Produto.Nome"? Esta ação é irreversível.
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-danger" type="submit">
                <i class="bi bi-check"></i>
                Confirmar exclusão
            </button>
            <a class="btn btn-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i>
                Voltar para a lista
            </a>
        </div>
    </form>
</div>
