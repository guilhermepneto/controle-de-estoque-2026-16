@model List<ListarRequisicaoEntradaViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Requisições de Entrada";
}

<p>
    <a class="btn btn-primary" asp-action="Cadastrar">Cadastrar requisição de entrada</a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">Nenhuma requisição de entrada cadastrada.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-4">
        @foreach (ListarRequisicaoEntradaViewModel requisicao in Model)
        {
            <div class="col">
                <article class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h2 class="h5 mb-0">@requisicao.NomeProduto</h2>
                        <span class="badge text-bg-secondary">@requisicao.Id</span>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-6">Funcionário</dt>
                            <dd class="col-sm-6">@requisicao.NomeFuncionario</dd>

                            <dt class="col-sm-6">Quantidade</dt>
                            <dd class="col-sm-6">@requisicao.Quantidade</dd>

                            <dt class="col-sm-6">Data</dt>
                            <dd class="col-sm-6">@requisicao.Data.ToShortDateString()</dd>
                        </dl>
                    </div>
                </article>
            </div>
        }
    </div>
}
